// Reuse the fixed local identity. Run scripts/setup-signing.py once before building.
// Never fall back to ad-hoc signing: a changing identity invalidates Accessibility grants.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Henry Local macOS Apps
DEVELOPMENT_TEAM =
OTHER_CODE_SIGN_FLAGS = --keychain "$(HOME)/.sign_keys_macos_app/codesign.keychain-db" --timestamp=none
// Self-signed identities have no Apple Team ID. Keep debug code in the executable
// rather than a separate preview dylib; retain hardened runtime/library validation.
ENABLE_DEBUG_DYLIB = NO

#include? "Local.xcconfig"
